return array(

    // Clave del proveedor de IA (MiniMax directo o una key de OpenRouter).
    // Si usas OpenRouter, crea una key EXCLUSIVA para la demo con un limite
    // de gasto bajo y vencimiento corto: si esta se filtra, la perdida esta
    // acotada por el limite y no por el saldo de la cuenta.
    'clave' => 'PEGAR_AQUI_LA_CLAVE',

    // MiniMax directo:
    //   'url' => 'https://api.minimax.io/v1/chat/completions',
    //
    // OpenRouter (recomendado para la demo: tope de gasto por clave y
    // disponibilidad si MiniMax se cae):
    //   'url' => 'https://openrouter.ai/api/v1/chat/completions',
    'url' => 'https://api.minimax.io/v1/chat/completions',

    // Con OpenRouter el modelo se nombra con su id publico.
    'modelo' => 'MiniMax-M3',

    // Interruptor de la demo. Va tambien dentro del ejecutable, asi que NO es
    // un secreto: cualquiera que descargue el instalador lo puede leer. Sirve
