/* =========================================================================
 * Tema Vogel 2026 - QSS global para RND
 *
 * Identidad visual oficial de Vogel Consultoria aplicada a la ventana
 * principal, formularios, grillas, dialogos y widgets de PyQt5.
 *
 * Paleta:
 *   navy-900   #083B6D   base de sidebar/encabezado
 *   navy-700   #0B568E   hover de barra lateral y elementos oscuros
 *   blue-500   #0A84D8   accion principal, seleccion, foco
 *   blue-600   #0866C8   hover/pressed de accion principal
 *   yellow-500 #F5C518   acento restringido (indicadores puntuales)
 *   bg         #F2F8FC   fondo de la ventana
 *   surface    #FFFFFF   tarjetas y campos
 *   text       #0F172A   texto principal
 *   text-muted #475569   texto secundario
 *   border     #E2E8F0   bordes suaves
 *   border-hi  #94A3B8   bordes de foco
 *   error      #B91C1C   errores y acciones destructivas
 *   success    #15803D   confirmaciones
 *
 * Tipografia: Segoe UI (sigue el sistema en Windows; usa sans-serif como
 * fallback multiplataforma).
 * Espaciado: multiplos de 4 (4, 8, 12, 16, 20, 24).
 * Bordes: radio 6 en superficies, 4 en campos, 12 en tarjetas destacadas.
 * ========================================================================= */


/* -----------------------------------------------------------------------
 * Tipografia y fondo base
 * --------------------------------------------------------------------- */
* {
    font-family: "Segoe UI", "Segoe UI Semibold", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
    color: #0F172A;
}

QMainWindow,
QWidget#shellCentralRoot {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #EAF6FC,
        stop:0.55 #F7FBFE,
        stop:1 #E4F2FA
    );
}

QWidget#areaCentralShell,
QWidget#shellCuerpo,
QDialog {
    background-color: #F2F8FC;
}

QWidget {
    /* Fondo seguro para cualquier formulario o contenedor sin selector.
     * No usar transparent aqui: en Windows con paleta oscura expone negro
     * mientras el texto global sigue siendo #0F172A. */
    background-color: #F2F8FC;
    selection-background-color: #0A84D8;
    selection-color: #FFFFFF;
}

/* Los formularios legacy heredan QDialog y no tienen objectName propio.
 * Esta regla debe quedar despues de QWidget: de otro modo el fondo
 * transparente expone el respaldo negro de la ventana nativa. */
QDialog {
    background-color: #F2F8FC;
    color: #0F172A;
}

/* Estos controles deben integrarse visualmente con la superficie que los
 * contiene; la transparencia queda acotada y ya no afecta contenedores. */
QLabel,
QCheckBox,
QRadioButton {
    background-color: transparent;
}


/* -----------------------------------------------------------------------
 * Encabezado del shell
 * --------------------------------------------------------------------- */
QFrame#encabezadoShell {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #073B70,
        stop:0.58 #0B5D97,
        stop:1 #087FC0
    );
    border: none;
    border-bottom: 1px solid #5BC7EC;
    min-height: 60px;
}

QLabel#encabezadoBrand {
    color: #F2F8FC;
    font-size: 14pt;
    font-weight: 600;
    letter-spacing: 0.4px;
    padding: 0 8px 0 4px;
}

QLabel#encabezadoUsuario,
QLabel#encabezadoServidor,
QLabel#encabezadoEstado,
QLabel#encabezadoVersion {
    color: #CBD5E1;
    font-size: 9pt;
    padding: 0 8px;
}

QLabel#encabezadoUsuario {
    color: #F2F8FC;
    font-weight: 600;
}

QPushButton#encabezadoBotonSalir {
    background-color: #0A84D8;
    color: #FFFFFF;
    border: 1px solid #0866C8;
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 28px;
    font-weight: 600;
}

QPushButton#encabezadoBotonSalir:hover {
    background-color: #0866C8;
}

QPushButton#encabezadoBotonSalir:pressed {
    background-color: #07529F;
}

QPushButton#encabezadoBotonSalir:focus {
    border: 2px solid #F5C518;
    padding: 5px 15px;
}

QPushButton#encabezadoBotonSalir:disabled {
    background-color: #475569;
    border-color: #334155;
    color: #CBD5E1;
}


/* -----------------------------------------------------------------------
 * Barra lateral del shell
 * --------------------------------------------------------------------- */
QFrame#barraLateralShell {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #073B70,
        stop:0.55 #0A4D83,
        stop:1 #0B6299
    );
    border: none;
    border-right: 1px solid #5BC7EC;
}

QTreeWidget#menuLateralArbol {
    background: transparent;
    alternate-background-color: #11264A;
    color: #E2E8F0;
    border: none;
    outline: 0;
    padding: 8px 4px;
    font-size: 10pt;
    show-decoration-selected: 1;
}

QTreeWidget#menuLateralArbol::item {
    height: 32px;
    padding: 4px 8px;
    border: none;
    border-radius: 4px;
    margin: 2px 4px;
    color: #E2E8F0;
}

QTreeWidget#menuLateralArbol::item:hover {
    background-color: #0B568E;
    color: #FFFFFF;
}

QTreeWidget#menuLateralArbol::item:selected {
    background-color: #0A84D8;
    color: #FFFFFF;
}

QTreeWidget#menuLateralArbol::item:selected:active {
    background-color: #0A84D8;
    color: #FFFFFF;
}

QTreeWidget#menuLateralArbol::item:selected:!active {
    background-color: #0866C8;
    color: #FFFFFF;
}

QTreeWidget#menuLateralArbol::branch {
    background-color: transparent;
}

QTreeWidget#menuLateralArbol QHeaderView::section {
    background-color: transparent;
    color: transparent;
    border: none;
    padding: 0;
    height: 0;
}


/* -----------------------------------------------------------------------
 * Area central / placeholder
 * --------------------------------------------------------------------- */
QStackedWidget#areaCentralShell {
    background-color: #F2F8FC;
    border: none;
}

QWidget#areaCentralPlaceholder {
    background-color: #F2F8FC;
}

QLabel#areaCentralPlaceholderTexto {
    color: #475569;
    font-size: 12pt;
    padding: 24px;
}


/* -----------------------------------------------------------------------
 * Dashboard operativo
 * --------------------------------------------------------------------- */
QWidget#dashboardRoot,
QWidget#dashboardContenido,
QWidget#dashboardCabecera,
QScrollArea#dashboardScroll,
QScrollArea#dashboardScroll QWidget#qt_scrollarea_viewport {
    background: transparent;
    border: none;
}

QLabel#dashboardTitulo {
    color: #083B6D;
    font-size: 20pt;
    font-weight: 700;
}

QLabel#dashboardSubtitulo {
    color: #64748B;
    font-size: 10pt;
}

QPushButton#dashboardBotonRecargar {
    background-color: #FFFFFF;
    color: #0866C8;
    border: 1px solid #B9E6F8;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 30px;
    font-weight: 600;
}

QPushButton#dashboardBotonRecargar:hover {
    background-color: #EFF6FF;
    border-color: #0A84D8;
}

QFrame#dashboardTarjetaHero {
    background-color: rgba(255,255,255,244);
    border: 1px solid #B8E1F2;
    border-left: 5px solid #13B7E8;
    border-radius: 16px;
    min-height: 190px;
}

QFrame#dashboardTarjetaHero:hover {
    border-color: #0A84D8;
    border-left: 5px solid #0A84D8;
}

QFrame#dashboardTarjetaHero:focus {
    border: 2px solid #F5C518;
    border-left: 5px solid #0A84D8;
}

QLabel#dashboardHeroTitulo {
    color: #475569;
    font-size: 11pt;
    font-weight: 600;
}

QLabel#dashboardHeroValor {
    color: #083B6D;
    font-size: 34pt;
    font-weight: 700;
}

QLabel#dashboardHeroDetalle {
    color: #64748B;
    font-size: 10pt;
}

QLabel#dashboardHeroEstado {
    color: #15803D;
    font-size: 9pt;
    font-weight: 600;
}

QFrame#dashboardTarjetaSecundaria {
    background-color: rgba(255,255,255,238);
    border: 1px solid #C8E6F4;
    border-radius: 14px;
    min-height: 130px;
}

QFrame#dashboardTarjetaSecundaria:hover {
    background-color: #F8FBFF;
    border-color: #0A84D8;
}

QFrame#dashboardTarjetaSecundaria:focus {
    border: 2px solid #F5C518;
}

QLabel#dashboardSecTitulo {
    color: #475569;
    font-size: 10pt;
    font-weight: 600;
}

QLabel#dashboardSecValor {
    color: #083B6D;
    font-size: 24pt;
    font-weight: 700;
}

QLabel#dashboardSecDetalle {
    color: #64748B;
    font-size: 9pt;
}

QProgressBar#dashboardHeroBarra,
QProgressBar#dashboardSecBarra {
    max-height: 5px;
    min-height: 5px;
    border: none;
    background-color: #DDF3FC;
    text-align: left;
}

QPushButton#dashboardHeroBotonReintentar,
QPushButton#dashboardSecBotonReintentar {
    background-color: transparent;
    color: #0866C8;
    border: 1px solid #0A84D8;
    border-radius: 6px;
    padding: 5px 12px;
}


/* -----------------------------------------------------------------------
 * Botones - estilos por rol
 * --------------------------------------------------------------------- */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 28px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:focus {
    border: 2px solid #0A84D8;
    padding: 5px 13px;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton[role="primary"],
QPushButton#primaryButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #19B9E7,
        stop:1 #0866C8
    );
    color: #FFFFFF;
    border: 1px solid #0A84D8;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: #0866C8;
}

QPushButton[role="primary"]:pressed {
    background-color: #07529F;
}

QPushButton[role="primary"]:focus {
    border: 2px solid #F5C518;
    padding: 5px 13px;
}

QPushButton[role="primary"]:disabled {
    background-color: #94A3B8;
    border-color: #94A3B8;
    color: #F1F5F9;
}

QPushButton[role="secondary"],
QPushButton#secondaryButton {
    background-color: transparent;
    color: #0A84D8;
    border: 1px solid #0A84D8;
}

QPushButton[role="secondary"]:hover {
    background-color: #DDF3FC;
}

QPushButton[role="secondary"]:pressed {
    background-color: #B9E6F8;
}

QPushButton[role="destructive"],
QPushButton#destructiveButton {
    background-color: #B91C1C;
    color: #FFFFFF;
    border: 1px solid #991B1B;
    font-weight: 600;
}

QPushButton[role="destructive"]:hover {
    background-color: #991B1B;
}

QPushButton[role="destructive"]:pressed {
    background-color: #7F1D1D;
}


/* -----------------------------------------------------------------------
 * Campos de entrada
 * --------------------------------------------------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #0A84D8;
    selection-color: #FFFFFF;
    min-height: 28px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 2px solid #0A84D8;
    padding: 5px 9px;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QLineEdit[error="true"],
QTextEdit[error="true"],
QPlainTextEdit[error="true"],
QSpinBox[error="true"],
QDoubleSpinBox[error="true"],
QComboBox[error="true"],
QDateEdit[error="true"],
QTimeEdit[error="true"],
QDateTimeEdit[error="true"] {
    border: 2px solid #B91C1C;
    padding: 5px 9px;
    background-color: #FEF2F2;
}

/* Combo: dropdown y selector */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E2E8F0;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    selection-background-color: #0A84D8;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: 0;
}


/* -----------------------------------------------------------------------
 * Tablas y grillas
 * --------------------------------------------------------------------- */
QTableView,
QTableWidget,
QTreeView,
QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F4FAFD;
    color: #14324F;
    border: 1px solid #B8DBEC;
    border-radius: 8px;
    gridline-color: #D7EAF3;
    selection-background-color: #0A84D8;
    selection-color: #FFFFFF;
    outline: 0;
}

QTableView::item,
QTableWidget::item,
QTreeView::item,
QTreeWidget::item {
    padding: 7px 9px;
    border: none;
    border-bottom: 1px solid #E6F1F7;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #E9F7FD;
    color: #0A3D67;
}

QTableView::item:selected,
QTableWidget::item:selected,
QTreeView::item:selected,
QTreeWidget::item:selected {
    background-color: #0A84D8;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #F4F7FA;
    color: #243447;
    padding: 9px 10px;
    border: none;
    border-right: 1px solid #D7DFEA;
    border-bottom: 2px solid #C7D2E0;
    font-weight: 700;
}

QHeaderView::section:hover {
    background-color: #EAF1F7;
    color: #083B6D;
}

QTableCornerButton::section {
    background-color: #F4F7FA;
    border: none;
    border-right: 1px solid #D7DFEA;
    border-bottom: 2px solid #C7D2E0;
}


/* -----------------------------------------------------------------------
 * Pestanas, grupos y marcos
 * --------------------------------------------------------------------- */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #475569;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #0F172A;
    background-color: #F1F5F9;
}

QTabBar::tab:selected {
    color: #0A84D8;
    border-bottom: 2px solid #0A84D8;
    background-color: #FFFFFF;
}

QTabBar::tab:disabled {
    color: #94A3B8;
}

QGroupBox {
    background-color: transparent;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #0F172A;
    background-color: transparent;
}


/* -----------------------------------------------------------------------
 * Menus, tooltips, status bar
 * --------------------------------------------------------------------- */
QMenuBar {
    background-color: #083B6D;
    color: #F2F8FC;
    padding: 4px 8px;
    border: none;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #0B568E;
    color: #FFFFFF;
}

QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 4px;
}

QMenu::item {
    padding: 6px 28px 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0A84D8;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 6px 8px;
}

QToolTip {
    background-color: #083B6D;
    color: #F2F8FC;
    border: 1px solid #0B568E;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 9pt;
}

QStatusBar {
    background-color: #083B6D;
    color: #F2F8FC;
    border-top: 1px solid #0B568E;
}

QStatusBar::item {
    border: none;
}


/* -----------------------------------------------------------------------
 * Checks, radios y barras
 * --------------------------------------------------------------------- */
QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #0F172A;
    background-color: transparent;
}

QCheckBox::indicator,
QGroupBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94A3B8;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover {
    border-color: #0A84D8;
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
    background-color: #0A84D8;
    border-color: #0866C8;
    image: none;
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94A3B8;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: #0A84D8;
}

QRadioButton::indicator:checked {
    background-color: #0A84D8;
    border: 1px solid #0866C8;
}

QRadioButton::indicator:checked:disabled {
    background-color: #94A3B8;
    border-color: #94A3B8;
}

QProgressBar {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    text-align: center;
    color: #0F172A;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #0A84D8;
    border-radius: 3px;
}


/* -----------------------------------------------------------------------
 * Scrollbars
 * --------------------------------------------------------------------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    width: 0;
}
