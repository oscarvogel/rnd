# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Local environments
.venv/
.venv-*/
venv/
env/

# Build artifacts
build/
dist/
*.spec.bak
installer/.demo_build_state
installer/.production_build_state

# Local configuration and secrets
.env
.env.*
!.env.example
*.secrets.*
sistema.local.ini
sistema.db

# Runtime logs
*.log
all.log
errors.log

# Local editor/cache metadata
.vscode/
.idea/
.codegraph/
.cursor/
.pyqt5libs_git_backup/

# Generated or local operational documents
documentacion/
*.xls
*.xlsx
*.csv
*.pdf

# Temporary files
*.tmp
*.bak
*.swp
Thumbs.db

# Excepción: fixtures de tests se versionan
!tests/fixtures/*.xls
!tests/fixtures/*.xlsx
!tests/fixtures/*.csv
!tests/fixtures/*.pdf

# Andamiaje local de desarrollo en Windows (no portable)
# setup_venv.bat tiene el path de Python 3.12 de esta maquina hardcodeado.
/pip_install.bat
/run_tests.bat
/setup_venv.bat
