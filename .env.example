# Database
RND_DB_USER=root
RND_DB_PASSWORD=
MYSQL_PASSWORD=

# Optional SQL Server integration
RND_SQLSERVER_USER=sa
RND_SQLSERVER_PASSWORD=

# Optional MongoDB integration
RND_MONGO_DB=formhub
RND_MONGO_USER=
RND_MONGO_PASSWORD=
RND_MONGO_AUTH_SOURCE=admin

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# MiniMax / IA compartida por RND.
# El asistente y la importacion PDF pueden reutilizar la misma MINIMAX_API_KEY.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# Optional AI vision provider for PDF/image order imports
# Defaults: MiniMax-M3 + https://api.minimax.io/v1/chat/completions
RND_PDF_AI_URL=
RND_PDF_AI_API_KEY=
RND_PDF_AI_MODEL=
RND_PDF_AI_TIMEOUT=120

# Optional overrides exclusivos del Asistente RND.
# Si se dejan vacios reutiliza RND_PDF_AI_* / MINIMAX_*.
RND_ASSISTANT_AI_URL=
RND_ASSISTANT_AI_API_KEY=
RND_ASSISTANT_AI_MODEL=
RND_ASSISTANT_AI_TIMEOUT=45
